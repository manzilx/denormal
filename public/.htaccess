# Denormal Labs — Apache / LiteSpeed config for Hostinger shared hosting.
# Astro emits pure static files, so this file carries everything the server
# has to decide: which hostname is canonical, what a missing page returns,
# and how long a browser may keep each kind of file.

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One canonical address. Everything else 301s to https://denormal.in so a
  # page is never indexed at two URLs. Order matters: strip www first, then
  # force TLS, so a http://www request lands in one hop rather than two.
  RewriteCond %{HTTP_HOST} ^www\.denormal\.in$ [NC]
  RewriteRule ^(.*)$ https://denormal.in/$1 [L,R=301]

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]
</IfModule>

# The site builds with trailingSlash: 'always', so /about/ is a directory with
# an index.html. mod_dir redirects /about to /about/ on its own.
ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
  # woff2 is already compressed — deflating it again only costs CPU.
</IfModule>

<IfModule mod_headers.c>
  # Astro fingerprints everything under /_astro/, so those URLs can never
  # change contents. Anything else is addressed by a stable path and must be
  # revalidated or a deploy will not reach people who have visited before.
  <IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/_astro/" IMMUTABLE_ASSET=1
  </IfModule>
  Header set Cache-Control "public, max-age=31536000, immutable" env=IMMUTABLE_ASSET

  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(svg|png|jpg|jpeg|webp|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

<IfModule mod_mime.c>
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>
