---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import NumberedCard from '../components/NumberedCard.astro';
import { products, productCountWord, capitalise } from '../data/products';
import { url } from '../lib/url';
---
<!-- TODO: add owner-supplied founding, team and location facts here when available. -->
<Base title="About Denormal Labs" description={`${capitalise(productCountWord)} systems, one thesis: auditable operations software.`}>
  <section class="product-hero"><div class="container product-hero-grid"><div><div class="product-index">00</div><h1 class="display">{capitalise(productCountWord)} systems.<br /><span style="color:var(--accent)">One thesis.</span></h1></div><div><div class="micro">ABOUT // DENORMAL LABS</div><p class="brief">Denormal Labs builds software for work where being wrong is expensive and being right has to be demonstrable. Across safety, procurement, quality, schedule, claims, statutory filing and production, the method stays consistent: structure the record, constrain the model, make the decision deterministic and return the proof with it.</p></div></div></section>
  <section class="section"><div class="container"><SectionHead eyebrow="The thesis" title="Best-effort software is not enough when the output becomes evidence." meta="GROUND // CONSTRAIN // DECIDE // PROVE" /><div class="card-grid">{products.slice(0, 3).map((product) => <NumberedCard number={product.index} code={product.name.toUpperCase().replaceAll(' ', '_')} title={product.name} body={product.tagline + ' ' + product.brief} stat={product.cardStat} href={url(`/products/${product.slug}/`)} />)}</div></div></section>
  <section class="section"><div class="container detail-layout"><div><SectionHead eyebrow="The portfolio" title="The method travels." meta="SAFETY // PROCUREMENT // QUALITY // SCHEDULE // CLAIMS // STATUTORY // PRODUCTION" /><p class="lede" style="margin-top:24px">Sentinel grounds safety advice in cited authorities and refuses to answer below its floor. Control Tower matches goods receipts with a matcher that holds no model. Quality AI makes a requirement unrepresentable without its source citation. Peak Logic keeps three CPM implementations in parity. OneLegal freezes the evidence before drafting. Sachiv computes every statutory date and figure before the model is allowed to describe it. AtelierOS keeps the sketch bound to the production record.</p></div><aside class="detail-sidebar"><div class="micro">COMPANY PROFILE</div><h3 style="margin-top:14px">Owner-supplied details pending.</h3><p class="lede" style="font-size:14px;line-height:21px;margin-top:10px">This page intentionally contains no invented founding story, team profile or location.</p></aside></div></section>
</Base>
