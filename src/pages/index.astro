---
import Base from '../layouts/Base.astro';
import ConsolePanel from '../components/ConsolePanel.astro';
import SectionHead from '../components/SectionHead.astro';
import NumberedCard from '../components/NumberedCard.astro';
import StageCard from '../components/StageCard.astro';
import MetricTile from '../components/MetricTile.astro';
import Intake from '../components/Intake.astro';
import { featuredProducts, portfolioMetrics, sharedStages, productCount, productCountWord, featuredCount, featuredCountWord, capitalise } from '../data/products';
import { url } from '../lib/url';
---
<Base title="Denormal Labs — operations software for manufacturing and complex projects" description="Denormal Labs builds operations software for manufacturing and complex projects, from processes we ran before we wrote them.">
  <section id="top" class="hero">
    <canvas class="hero-field" data-hero-field="h" aria-hidden="true"></canvas>
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="badge micro">Built from the operating side</div>
        <h1 class="display">We knew the <span style="color:var(--accent)">process</span> before we wrote the software.</h1>
        <p class="lede">Denormal Labs builds operations software for manufacturing and complex projects. Each system starts from a process we have actually run — its decision gates, approvals, evidence and audit trail — and the technology is chosen to serve that process, not to replace the judgement inside it.</p>
        <div class="hero-actions"><a class="button primary" href="#products">See the portfolio <span>→</span></a><a class="button secondary" href="#intake">Talk to engineering</a></div>
        <div class="gauge" aria-label="The Denormal method">
          <div class="gauge-head"><span class="micro">The denormal method</span><span class="micro">Four stages // all load-bearing</span></div>
          <svg class="method-figure" viewBox="0 0 240 12" preserveAspectRatio="none" aria-hidden="true"><rect x="0" y="3" width="240" height="6" fill="var(--line)"></rect><rect class="advance" x="0" y="3" width="240" height="6"></rect><rect x="58" y="0" width="4" height="12" fill="var(--bg)"></rect><rect x="118" y="0" width="4" height="12" fill="var(--bg)"></rect><rect x="178" y="0" width="4" height="12" fill="var(--bg)"></rect><rect x="59" y="0" width="1" height="12" fill="var(--line-2)"></rect><rect x="119" y="0" width="1" height="12" fill="var(--line-2)"></rect><rect x="179" y="0" width="1" height="12" fill="var(--line-2)"></rect></svg>
          <div class="gauge-labels"><span>01 Ground</span><span>02 Constrain</span><span>03 Decide</span><span>04 Prove</span></div>
        </div>
      </div>
      <ConsolePanel />
    </div>
  </section>

  <section id="sectors" class="sectors"><div class="container sector-line"><span class="sector-label">Where the work gets expensive</span><span class="sector-rule"></span><span>Manufacturing</span><span class="sector-sep">/</span><span>Complex projects</span><span class="sector-sep">/</span><span>Tendering</span><span class="sector-sep">/</span><span>Safety</span><span class="sector-sep">/</span><span>Supply</span><span class="sector-sep">/</span><span>Quality</span><span class="sector-sep">/</span><span>Claims</span><span class="sector-sep">/</span><span>Cash</span></div></section>

  <section id="products" class="section"><div class="container"><SectionHead eyebrow={`Portfolio // ${featuredCount} systems`} title={`One method. ${capitalise(featuredCountWord)} places we have worked.`} meta={`FOCUS: ${featuredCount} SYSTEMS // MEASURED IN-REPO`} /><div class="card-grid">{featuredProducts.map((product) => <NumberedCard number={product.index} glyph={product.slug} code={product.name.toUpperCase().replaceAll(' ', '_')} title={product.name} body={product.brief} stat={product.cardStat} href={url(`/products/${product.slug}/`)} selectable={true} />)}</div><p class="grid-note"><a href={url('/portfolio/')}>See all {productCountWord} systems we have built →</a></p></div></section>

  <section id="runtime" class="section"><div class="container"><SectionHead eyebrow="Runtime // Shared method" title="The model is useful. The system is accountable." meta="GROUND → CONSTRAIN → DECIDE → PROVE" /><div class="runtime-grid">{sharedStages.map((stage) => <StageCard stage={stage} />)}</div></div></section>

  <section id="benchmarks" class="section band"><div class="container"><SectionHead eyebrow="Measured in-repo" title="Proof before promises." meta={`MEASURED IN-REPO // ACROSS ALL ${productCount} SYSTEMS`} /><div class="metric-grid">{portfolioMetrics.map((metric) => <MetricTile metric={metric} />)}</div></div></section>

  <section id="security" class="section"><div class="container"><SectionHead eyebrow="Privacy &amp; security" title="Your data does not have to leave to be useful." meta="POSTURE // TRACEABLE TO SOURCE" /><div class="card-grid">
    <NumberedCard number="01" code="RESIDENCY" title="The sensitive path can run with no model vendor" body="Eight of the ten do, by four different mechanisms. Sentinel forces deterministic stubs and local embeddings. Control Tower and Sachiv fall back to written templates and a rule engine. AtelierOS and Power Contract Intelligence ship keyless embedders as the default. NexusRef carries a deterministic twin for every AI surface, and OneLegal's code default is a local inference endpoint." stat={['8 of 10', 'run with no model vendor']} />
    <NumberedCard number="02" code="ISOLATION" title="Separated by construction, not by a filter" body="OneLegal gives every matter its own vector collection, so a query cannot physically reach another matter's index — proven by a seeded canary that fails loudly. Peak Logic's org guard refuses an unregistered route rather than allowing it through." stat={['Fail-closed', 'unregistered routes refused']} />
    <NumberedCard number="03" code="AUDIT" title="Two trails built to survive an adversary" body="Quality AI's audit log is append-only enforced by database triggers, written in the same transaction as the change it records. OneLegal keeps a SHA-256 hash chain, flushed to disk per event, that detects tampering, deletion and re-linking — and verifies offline." stat={['SHA-256', 'chained and verifiable']} />
    <NumberedCard number="04" code="BOUNDARY" title="Retrieved content is data, never instruction" body="OneLegal marks every evidence excerpt as untrusted material the model may not obey, screens it against known injection patterns, and flags rather than silently refusing. Filing, signing, serving and deleting are refused to any automated path, leaving a human route only." stat={['Human-only', 'for external actions']} />
  </div>
  <div class="disclosure"><div class="micro">Where the line is</div><p>These are engineering postures, not audited controls. There is no SOC 2 or ISO 27001 certification behind them, no encryption at rest, and no single sign-on in any of these systems today. Several run on self-asserted identity headers and are built for a trusted network rather than the open internet. We would rather you knew that from us than found it in a security review.</p></div>
  </div></section>

  <Intake />
</Base>
