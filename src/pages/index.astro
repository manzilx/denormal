---
import Base from '../layouts/Base.astro';
import ConsolePanel from '../components/ConsolePanel.astro';
import SectionHead from '../components/SectionHead.astro';
import NumberedCard from '../components/NumberedCard.astro';
import StageCard from '../components/StageCard.astro';
import MetricTile from '../components/MetricTile.astro';
import Intake from '../components/Intake.astro';
import { products, portfolioMetrics, sharedStages, productCount, productCountWord, capitalise } from '../data/products';
import { url } from '../lib/url';
---
<Base title="Denormal Labs — Software for work that has to be provable" description="Denormal Labs builds operating systems for safety, contracts, quality, schedule and production.">
  <section id="top" class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="badge micro">{productCountWord.toUpperCase()} SYSTEMS // ONE THESIS</div>
        <h1 class="display">Software for work that has to be <span style="color:var(--accent)">provable</span>.</h1>
        <p class="lede">Denormal Labs builds operating systems for industries where being wrong is expensive and being right has to be demonstrable — safety, contracts, quality, schedule and production. Deterministic engines make the decisions. Language models read, classify and draft, and every answer carries its source, its grounding and its audit row.</p>
        <div class="hero-actions"><a class="button primary" href="#products">See the portfolio <span>→</span></a><a class="button secondary" href="#intake">Talk to engineering</a></div>
        <div class="gauge" aria-label="The Denormal method">
          <div class="gauge-head"><span class="micro">The denormal method</span><span class="micro">Four stages // all load-bearing</span></div>
          <div class="gauge-bars"><i></i><i></i><i></i><i></i></div>
          <div class="gauge-labels"><span>01 Ground</span><span>02 Constrain</span><span>03 Decide</span><span>04 Prove</span></div>
        </div>
      </div>
      <ConsolePanel />
    </div>
  </section>

  <section id="sectors" class="sectors"><div class="container sector-line"><span class="sector-label">Where the work gets expensive</span><span class="sector-rule"></span><span>Industrial safety</span><span class="sector-sep">/</span><span>Contracts &amp; claims</span><span class="sector-sep">/</span><span>EPC quality assurance</span><span class="sector-sep">/</span><span>Project controls</span><span class="sector-sep">/</span><span>Apparel production</span></div></section>

  <section id="products" class="section"><div class="container"><SectionHead eyebrow={`Portfolio // ${productCount} systems`} title={`One method. ${capitalise(productCountWord)} places where evidence matters.`} meta={`PORTFOLIO: ${productCount} SYSTEMS // MEASURED IN-REPO`} /><div class="card-grid">{products.map((product, index) => <NumberedCard number={product.index} code={product.name.toUpperCase().replaceAll(' ', '_')} title={product.name} body={product.brief} stat={product.cardStat} href={url(`/products/${product.slug}/`)} accent={index === 1} />)}</div></div></section>

  <section id="runtime" class="section"><div class="container"><SectionHead eyebrow="Runtime // Shared method" title="The model is useful. The system is accountable." meta="GROUND → CONSTRAIN → DECIDE → PROVE" /><div class="runtime-grid">{sharedStages.map((stage) => <StageCard stage={stage} />)}</div></div></section>

  <section id="benchmarks" class="section band"><div class="container"><SectionHead eyebrow="Measured in-repo" title="Proof before promises." meta={`PORTFOLIO: ${productCount} SYSTEMS // MEASURED IN-REPO`} /><div class="metric-grid">{portfolioMetrics.map((metric) => <MetricTile metric={metric} />)}</div></div></section>

  <Intake />
</Base>
