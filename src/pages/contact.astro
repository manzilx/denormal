---
import Base from '../layouts/Base.astro';
import Intake from '../components/Intake.astro';
---
<Base title="Contact Denormal Labs" description="Start a product engineering conversation with Denormal Labs.">
  <section class="product-hero"><div class="container product-hero-grid"><div><div class="product-index">→</div><h1 class="display">Talk to<br /><span style="color:var(--accent)">engineering.</span></h1></div><div><div class="micro">CONTACT // PRODUCT ENGINEERING</div><p class="brief">Bring the workflow, record or decision that needs a defensible path. The intake is a presentational starting point while the direct mailbox route is being finalized.</p></div></div></section>
  <Intake title="Route the right system into the work." description="Choose the product closest to the problem and describe where the process breaks down. No network request is made by this form." eyebrow="CONTACT // ENGINEERING INTAKE" />
</Base>
