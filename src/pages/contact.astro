---
import Base from '../layouts/Base.astro';
import Intake from '../components/Intake.astro';
---
<Base title="Contact Denormal Labs" description="Start a product engineering conversation with Denormal Labs." bodyClass="has-grid">
  <section class="product-hero"><canvas class="hero-field" data-hero-field="v" aria-hidden="true"></canvas><div class="container product-hero-grid"><div><div class="product-index">→</div><h1 class="display">Talk to<br /><span style="color:var(--accent)">engineering.</span></h1></div><div><div class="micro">CONTACT // PRODUCT ENGINEERING</div><p class="brief">Bring the workflow, record or decision that needs a defensible path. It reaches engineering directly.</p></div></div></section>
  <Intake title="Route the right system into the work." description="Choose the product closest to the problem and describe where the process breaks down. It reaches engineering directly." eyebrow="CONTACT // ENGINEERING INTAKE" />
</Base>
