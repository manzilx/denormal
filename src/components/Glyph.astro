---
import type { ProductSlug } from '../data/products';

// One mark per product, each drawn as a schematic of what the system actually
// does rather than the industry it sits in. All ten share a 32-unit grid,
// orthogonal or 45-degree geometry, square caps and mitred joins — the same
// construction as the wordmark rule. Exactly one element per glyph carries the
// accent, and it is always the load-bearing part of the mechanism.
//
// Stroke widths come from CSS custom properties, not attributes, so a larger
// placement can thin the line rather than scaling it into a slab.
const glyphs: Record<ProductSlug, string> = {
  // A citation bracket closing on the one passage that grounded the finding.
  // The index resolves only to chunks the model was shown, so the bracket sits
  // around a line that is shorter than the rest: a quoted span, not the page.
  'power-contract-intelligence': `
    <path class="g-a" d="M9 13.5 H5 V19.5 H9" />
    <line x1="13" y1="7" x2="28" y2="7" />
    <line x1="13" y1="12" x2="28" y2="12" />
    <line class="g-a" x1="13" y1="16.5" x2="24" y2="16.5" />
    <line x1="13" y1="21" x2="28" y2="21" />
    <line x1="13" y1="26" x2="22" y2="26" />`,

  // Capture brackets around a measured value standing on a floor. Below the
  // floor the system returns insufficient sources, so the floor is the accent.
  sentinel: `
    <path d="M4 10 V4 H10" />
    <path d="M22 4 H28 V10" />
    <path d="M4 22 V28 H10" />
    <path d="M22 28 H28 V22" />
    <line x1="16" y1="20" x2="16" y2="11" />
    <line class="g-a" x1="7" y1="20" x2="25" y2="20" />`,

  // A line traced across three states, ascending. The last node is solid
  // because the receipt at the site store is the only one physically verified.
  'control-tower': `
    <rect x="3" y="21" width="5.5" height="5.5" />
    <line x1="8.5" y1="21" x2="13.25" y2="18.75" />
    <rect x="13.25" y="13.25" width="5.5" height="5.5" />
    <line x1="18.75" y1="13.25" x2="23.5" y2="11" />
    <rect class="g-af" x="23.5" y="5.5" width="5.5" height="5.5" />`,

  // Flow arriving at a hold point. The gate is accent and full height; what
  // lies beyond it is dashed, because it cannot be reached until the gate lifts.
  'quality-ai': `
    <line x1="3" y1="16" x2="12.5" y2="16" />
    <path d="M9.5 12.5 L13 16 L9.5 19.5" />
    <line class="g-a" x1="16" y1="4" x2="16" y2="28" />
    <line x1="19.5" y1="16" x2="29" y2="16" stroke-dasharray="2.5 2.5" />`,

  // A bar with its float drawn open, and a successor starting inside that
  // float. Solid is work; the accent outline is the slack you have to defend.
  peaklogic: `
    <rect class="g-f" x="3" y="6" width="12" height="4.5" />
    <rect class="g-a" x="16" y="6" width="9" height="4.5" />
    <path d="M15 10.5 V17 H21 V21" />
    <rect class="g-f" x="21" y="21" width="8" height="4.5" />`,

  // A filed record with its reference tab struck through the margin. The tag
  // is the accent because the number, not the letter, is what survives.
  nexusref: `
    <rect class="g-af" x="3" y="9" width="6.5" height="4" />
    <rect x="9.5" y="4" width="19.5" height="24" />
    <line x1="13.5" y1="14" x2="25" y2="14" />
    <line x1="13.5" y1="19" x2="25" y2="19" />
    <line x1="13.5" y1="24" x2="21" y2="24" />`,

  // Two interlocked links inside a set whose lid is sealed shut. Drafting may
  // only run over what is under the seal, so the seal carries the accent.
  onelegal: `
    <rect class="g-af" x="4" y="6.5" width="24" height="3" />
    <rect x="4" y="10.5" width="24" height="17.5" />
    <rect x="9" y="15" width="8" height="8" />
    <rect x="15" y="15" width="8" height="8" />`,

  // A forecast cone opening from a known position to a horizon. The centre
  // line is accent: the published P50, seeded so it reproduces exactly.
  foretell: `
    <rect class="g-f" x="3" y="14.5" width="3" height="3" />
    <path d="M6 16 L28 6" />
    <path d="M6 16 L28 26" />
    <line x1="28" y1="6" x2="28" y2="26" />
    <path class="g-a" d="M6 16 L28 16" />`,

  // A statutory calendar with one cell already claimed. The due date is the
  // accent because the clock, not the filing, is what accrues against you.
  sachiv: `
    <line x1="10" y1="3" x2="10" y2="7" />
    <line x1="22" y1="3" x2="22" y2="7" />
    <rect x="4" y="6" width="24" height="22" />
    <line x1="4" y1="12.5" x2="28" y2="12.5" />
    <line x1="16" y1="12.5" x2="16" y2="28" />
    <line x1="4" y1="20.5" x2="28" y2="20.5" />
    <rect class="g-af" x="17" y="13.5" width="10" height="6" />`,

  // A drawn silhouette beside a dimension with its tolerance ticks. The sketch
  // stays plain and the measurement is accent, because the spec is what ships.
  atelier: `
    <path d="M4 28 C 6 16, 11 7, 19 4" />
    <line x1="21.5" y1="7" x2="28.5" y2="7" />
    <line x1="21.5" y1="27" x2="28.5" y2="27" />
    <line class="g-a" x1="25" y1="7" x2="25" y2="27" />`
};

interface Props {
  slug: ProductSlug;
}

const { slug } = Astro.props;
---
<svg class="glyph" viewBox="0 0 32 32" aria-hidden="true" focusable="false" set:html={glyphs[slug]} />
