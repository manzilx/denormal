---
import Glyph from './Glyph.astro';
const { number, code, title, body, stat, href, glyph, accent = false, selectable = false } = Astro.props;
---
<article class:list={['number-card', { accent, selectable }]} data-select-card={selectable ? '' : undefined}>
  <div class="card-head">
    <div class="card-code micro">{number} // {code}</div>
    {glyph && <span class="card-glyph"><Glyph slug={glyph} /></span>}
  </div>
  <h3>{title}</h3>
  <p>{body}</p>
  <div class="card-foot">
    {stat && <div class="card-stat"><strong>{stat[0]}</strong><span>{stat[1]}</span></div>}
    {href && <a class="card-link" href={href}>Open system →</a>}
  </div>
</article>
