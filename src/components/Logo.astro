---
const { small = false } = Astro.props;
---
<span class:list={['brand', { small }]}>
  <span class="brand-word">denormal</span>
  <span class="logo-rule">
    <svg class="logo-mark" viewBox="0 0 200 16" preserveAspectRatio="none" aria-hidden="true">
    <rect x="0" y="13" width="200" height="3" fill="currentColor" />
    <rect x="0" y="0" width="3" height="13" fill="currentColor" />
    <rect x="65" y="6" width="3" height="7" fill="currentColor" />
    <rect x="131" y="6" width="3" height="7" fill="currentColor" />
    <rect x="197" y="6" width="3" height="7" fill="currentColor" />
    <rect id="dnrm-fill" x="3" y="7" width="62" height="6" fill="var(--accent)" />
    </svg>
  </span>
  {!small && <span class="brand-kicker">LABS</span>}
</span>
